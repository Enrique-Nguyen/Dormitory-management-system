# Chép thành DMS/.env nếu muốn đổi mặc định. Không commit file .env.
DB_NAME=dms
DB_USERNAME=dms
DB_PASSWORD=dms
DB_PORT=5432

# Điền secret riêng rồi lưu vào .env (không commit).
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=keycloak-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
DMS_KEYCLOAK_ADMIN_CLIENT_SECRET=
# Tài khoản Admin đầu tiên của DMS khi chạy bằng DMS/scripts/start-docker.ps1.
DMS_KEYCLOAK_INITIAL_ADMIN_USERNAME=admin
DMS_KEYCLOAK_INITIAL_ADMIN_PASSWORD=
