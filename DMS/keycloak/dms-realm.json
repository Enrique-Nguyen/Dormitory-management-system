{
  "realm": "dms",
  "enabled": true,
  "displayName": "Hệ thống Quản lý Ký túc xá",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(8) and digits(1) and regexPattern(^(?=.*[A-Za-z]).{8,64}$) and passwordHistory(1)",
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "STAFF"
      },
      {
        "name": "TECHNICIAN"
      },
      {
        "name": "STUDENT"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dms-web",
      "name": "DMS React",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "DMS API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "dms-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "DMS security version",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "dms_security_version",
            "claim.name": "dms_security_version",
            "jsonType.label": "long",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "dms-admin",
      "name": "DMS backend account management",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${DMS_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "roles"
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-dms-admin",
      "enabled": true,
      "serviceAccountClientId": "dms-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "view-realm"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 1, \"max\": 50}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}}, {\"name\": \"dms_security_version\", \"displayName\": \"Phiên bản bảo mật DMS\", \"validations\": {\"integer\": {\"min\": 0}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}}], \"unmanagedAttributePolicy\": \"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "dms-web",
      "roles": [
        "ADMIN",
        "STAFF",
        "TECHNICIAN",
        "STUDENT"
      ]
    }
  ]
}
