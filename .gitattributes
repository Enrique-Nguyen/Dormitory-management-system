# Lưu LF trong repo cho mọi file văn bản, kể cả khi commit từ Windows
* text=auto eol=lf

# Script Windows giữ CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# File nhị phân
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.xlsx binary
*.docx binary
*.pptx binary
*.pdf binary
*.jar binary
